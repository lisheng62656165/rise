# Reference only: NOT automatically loaded. Set variables in your shell.
# Never commit real credentials. The full pipeline accepts OPENAI_API_KEY too.
MIMO_API_KEY=
MIMO_BASE_URL=https://api.openai.com/v1
MIMO_MODEL=gpt-4.1
MIMO_TEMPERATURE=0
MIMO_MAX_TOKENS=4096
# EDS binary selector only. Official ORM Best4 is fixed at 2048.
MIMO_SELECTOR_MAX_TOKENS=8192
MIMO_TIMEOUT_SECONDS=180
MIMO_RETRY_ATTEMPTS=3
MIMO_ACTIVE_REQUESTS=32
# Optional private newline-separated key pool; assigned per new client.
# MIMO_API_KEYS_FILE=/private/statebench_keys.txt
# Explicit compatibility switches, only when your provider requires them:
# MIMO_SEND_SEED=0
# MIMO_SEND_TEMPERATURE=0
# MIMO_TOKEN_PARAMETER=max_completion_tokens
# Optional provider-supported reasoning/streaming settings:
# MIMO_REASONING_EFFORT=high
# MIMO_STREAMING=1
