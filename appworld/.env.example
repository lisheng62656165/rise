OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_API_KEY=your-api-key
MODEL_NAME=gpt-4.1
MAX_COMPLETION_TOKENS=4096
REQUEST_TIMEOUT=180
REQUEST_RETRIES=5
# These limits are PER WORKER, not account-wide.
MAX_RPM=6
MAX_TPM=8000000
TEMPERATURE=0
# For reasoning models, increase completion budgets and use auto or 1.
OPENAI_REASONING=auto
SEND_SEED=1
